# ═══════════════════════════════════════════════════════════════
# Teste de carga — variáveis de ambiente (PLACEHOLDERS)
#
# 1. Copie este arquivo para load-tests/.env
# 2. Preencha com valores reais (o .gitignore já ignora .env — NUNCA
#    commite o arquivo preenchido)
# 3. Carregue na sessão do PowerShell com o snippet do README.md
# ═══════════════════════════════════════════════════════════════

# Alvo do teste (backend VPS)
BASE_URL=https://api.vrtxcrm.com.br

# Supabase do projeto (mesmos valores do frontend: VITE_SUPABASE_URL /
# VITE_SUPABASE_ANON_KEY no Vercel, ou SUPABASE_URL/SUPABASE_ANON_KEY na VPS)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=COLE_A_ANON_KEY_AQUI

# Credenciais do usuário do workspace "Teste" (login é feito no setup de
# cada k6 run — token sempre fresco). NUNCA use credenciais de cliente real.
TEST_EMAIL=usuario-teste@exemplo.com
TEST_PASSWORD=COLE_A_SENHA_AQUI

# Alternativa: cole um access_token direto (tem prioridade sobre email/senha).
# Atenção: expira em ~1h.
# K6_JWT=

# Inclui GET /api/admin/workspaces na mix de leitura (estágios 01 e 02).
# Exige que o JWT seja de um usuário presente em ADMIN_USER_IDS na VPS.
ENABLE_ADMIN=0
